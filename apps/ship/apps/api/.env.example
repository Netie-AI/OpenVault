# FreeBuild API - Environment Variables
# Copy this file to .env and fill in the values.
# Modified by Netie AI, 2026: renamed to FreeBuild; the hosted cloud, billing and
# vendor credential settings are removed because that mode is disabled.

NODE_ENV=development

# ---------- Mode ----------
# OPENSHIP_TARGET selects the runtime-target row (URLs/ports/mode) in
# packages/core/src/runtime-config.ts. THE mode knob: `dev` loads this file.
OPENSHIP_TARGET=local
# Hosted cloud mode is disabled in FreeBuild and forced off by the API. Leave false.
CLOUD_MODE=false
# Set to "true" when this API sits behind an edge/proxy that already rate-limits
# (the FreeBuild edge, or your own reverse proxy). Skips the app-level pre-auth
# flood guard as redundant. Auto-implied under CLOUD_MODE. Leave false on a
# standalone self-hosted API so the flood guard still protects the session lookup.
OPENSHIP_TRUST_EDGE=false
DEPLOY_MODE=desktop
# REQUIRED whenever DEPLOY_MODE=desktop — env.ts refuses to boot without it, so
# a copied .env fails on the first `npm run dev` if this is missing. The launcher
# declares the auth mode rather than it being inferred from the deploy mode:
#   none  → zero-auth desktop path, no login screen (what the packaged app sets)
#   local → email + password login
OPENSHIP_AUTH_MODE=none

# ---------- Database ----------
DATABASE_URL=file:./dev.db

# ---------- Auth ----------
BETTER_AUTH_SECRET=change-me-in-production

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Self-hosted GitHub App (optional) ----------
# Configure every field to use your own App in GITHUB_AUTH_MODE=auto.
# The OAuth client credentials validate install ownership; the PEM mints
# short-lived installation tokens; the webhook secret verifies App events.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY_BASE64=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=your-app-slug
