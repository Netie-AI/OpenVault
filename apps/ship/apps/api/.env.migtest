# Throwaway self-hosted instance for the Docker-migration E2E test ONLY.
# Zero-auth (desktop + loopback) so localhost calls run as the local admin.
# Own PGlite dir so it never touches a real instance's data.
# Modified by Netie AI, 2026: the data dir was a developer's home path; it is now relative.
NODE_ENV=development
PORT=4300
OPENSHIP_TARGET=local
DEPLOY_MODE=desktop
# Required with DEPLOY_MODE=desktop (env.ts boot check). This harness already
# runs zero-auth, so "none" matches what it was relying on being inferred.
OPENSHIP_AUTH_MODE=none
OPENSHIP_ALLOW_ZERO_AUTH=true
PGLITE_DATA_DIR=./.pglite/migtest
BETTER_AUTH_SECRET=migtest-secret-not-for-production-000000
BETTER_AUTH_URL=http://localhost:4300
OPENSHIP_REQUIRE_REDIS=false
OPENSHIP_API_HOST=127.0.0.1
