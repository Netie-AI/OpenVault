{
  "name": "@repo/dashboard",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "ENV_FILE=.env NODE_OPTIONS=\"$NODE_OPTIONS --import ./scripts/load-env.mjs\" next dev -p ${PORT:-3031} -H ${HOSTNAME:-127.0.0.1}",
    "dev:saas": "ENV_FILE=.env.saas NODE_OPTIONS=\"$NODE_OPTIONS --import ./scripts/load-env.mjs\" next dev",
    "dev:local-saas": "ENV_FILE=.env.local-saas NODE_OPTIONS=\"$NODE_OPTIONS --import ./scripts/load-env.mjs\" next dev",
    "dev:fresh": "rm -rf .next/cache && ENV_FILE=.env NODE_OPTIONS=\"$NODE_OPTIONS --import ./scripts/load-env.mjs\" next dev -p ${PORT:-3031} -H ${HOSTNAME:-127.0.0.1}",
    "build": "next build --webpack",
    "start": "ENV_FILE=.env NODE_OPTIONS=\"$NODE_OPTIONS --import ./scripts/load-env.mjs\" next start -p ${PORT:-3031} -H ${HOSTNAME:-127.0.0.1}",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@repo/contracts": "*",
    "@repo/core": "*",
    "@repo/onboarding": "*",
    "@repo/ui": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.6",
    "better-auth": "^1.5.4",
    "chart.js": "^4.4.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-is": "^19.3.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "happy-dom": "^20.11.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
