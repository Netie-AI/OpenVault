# FreeBuild Dashboard — local dev. Copy to `.env`; `dev` loads it (node --env-file=.env).
# Non-secret runtime config: the mode lives HERE, not in a wrapper script.
# OPENSHIP_TARGET selects the runtime-target row in packages/core/runtime-config.ts.
# Modified by Netie AI, 2026: default port 3031 and loopback-only bind (see
# PRODUCT_ROLES.md); the upstream cdn.oblien.com icon host is not used.
OPENSHIP_TARGET=local
OPENSHIP_CLOUD_TARGET=local-saas
PORT=3031
HOSTNAME=127.0.0.1
NEXT_DIST_DIR=.next

# Optional asset host for the shared icon catalog. Unset uses bundled /icons.
# OPENSHIP_ICON_BASE_URL=
